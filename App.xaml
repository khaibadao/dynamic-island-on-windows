<Application x:Class="DynamicIslandNotifier.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Tray Icon -->
            <tb:TaskbarIcon x:Key="TrayIcon"
                            IconSource="/Assets/island.ico"
                            ToolTipText="Dynamic Island Notifier">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Dynamic Island Notifier" IsEnabled="False" FontWeight="Bold"/>
                        <Separator/>
                        <MenuItem Header="Enable / Disable" Click="Toggle_Click"/>
                        <MenuItem Header="Notch bar" Tag="notch" IsCheckable="True" Click="NotchToggle_Click"/>
                        <MenuItem Header="Music: On" Tag="music" Click="MusicToggle_Click"/>
                        <MenuItem Header="Start with Windows" Tag="autostart" IsCheckable="True" Click="AutoStartToggle_Click"/>
                        <MenuItem Header="Hiện mèo" Tag="showcat" IsCheckable="True" Click="ShowCat_Click"/>
                        <MenuItem Header="Mèo đi dạo" Tag="maywalk" IsCheckable="True" Click="MayWalkToggle_Click"/>
                        <MenuItem Header="Ẩn khi toàn màn hình" Tag="fullscreen" IsCheckable="True" Click="FullscreenToggle_Click"/>
                        <MenuItem Header="Loang màu" Tag="ambient">
                            <MenuItem Header="Đầy đủ (nốt nhạc trôi)" Tag="full" IsCheckable="True" Click="Ambient_Click"/>
                            <MenuItem Header="Nhẹ (đứng yên, không trôi)" Tag="light" IsCheckable="True" Click="Ambient_Click"/>
                            <MenuItem Header="Tắt" Tag="off" IsCheckable="True" Click="Ambient_Click"/>
                            <Separator Tag="why"/>
                            <MenuItem Tag="why" IsEnabled="False"/>
                        </MenuItem>
                        <Separator/>
                        <!-- Filled in code each time the menu opens -->
                        <MenuItem Header="Recent notifications" Tag="history">
                            <MenuItem Header="…" IsEnabled="False"/>
                        </MenuItem>
                        <MenuItem Header="Muted" Tag="muted">
                            <MenuItem Header="…" IsEnabled="False"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Cài đặt &amp; quyền riêng tư…" Click="Settings_Click"/>
                        <MenuItem Header="Kiểm tra cập nhật" Click="CheckUpdate_Click"/>
                        <MenuItem Header="Quit" Click="Quit_Click"/>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
