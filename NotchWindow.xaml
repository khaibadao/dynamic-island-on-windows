<Window x:Class="DynamicIslandNotifier.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DynamicIslandNotifier.UI"
        Title="DynamicIslandNotch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Left="0" Top="0">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Album colour (replaced from code) -->
        <SolidColorBrush x:Key="AccentBrush" Color="White"/>

        <!-- Tabs: Nhạc / Trồng cây / Thông báo -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="12" Padding="10,4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="#DDFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2C2C2E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round, borderless button (⏮ ⏯ ⏭) -->
        <Style x:Key="PlayerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded pill button: "Trồng cây", "Bỏ cuộc" -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#34C759"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Duration chips: 10p 25p 45p ... -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="#2A2A2A" CornerRadius="11" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#34C759"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider parts: filled part, remaining part, round knob -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderRest" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#40FFFFFF" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderKnob" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="knob" Width="12" Height="12" Fill="White"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="knob" Property="Width" Value="14"/>
                                <Setter TargetName="knob" Property="Height" Value="14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IslandSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRest}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderKnob}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Side and bottom margin leaves room for the glow -->
    <Grid Margin="24,0,24,24">

        <!-- ══════════ RESTING: a thin coloured strip, so browser tabs stay clickable ══════════ -->
        <!-- A slightly taller invisible area makes it easy to hit with the mouse at the top edge. -->
        <Border x:Name="StripHost"
                Height="9"
                Width="200"
                Background="#01000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Cursor="Hand"
                MouseEnter="Strip_MouseEnter">
            <!-- Trapezoid  \_______/ : wide along the screen edge, narrower below, soft corners -->
            <Path x:Name="Strip" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="#3A3A3C"
                  Data="M 0,0 L 200,0 L 190,4.6 Q 187,6 183,6 L 17,6 Q 13,6 10,4.6 Z">
                <Path.Effect>
                    <DropShadowEffect x:Name="StripGlow" Color="#5A5A5E" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                </Path.Effect>
            </Path>
        </Border>

        <!-- ══════════ COLLAPSED: the notch (on hover / for a moment on news) ══════════ -->
        <Border x:Name="Pill"
                Visibility="Collapsed"
                Background="#000000"
                BorderThickness="1,0,1,1"
                BorderBrush="#3A3A3C"
                CornerRadius="0,0,15,15"
                Height="28"
                MinWidth="190"
                Padding="8,0,12,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Cursor="Hand"
                MouseEnter="Pill_MouseEnter"
                MouseLeave="Pill_MouseLeave"
                MouseLeftButtonUp="Pill_MouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect x:Name="PillGlow" Color="#5A5A5E" BlurRadius="14" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: album art, or the growing tree -->
                <Grid x:Name="PillLeft" Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                    <Grid x:Name="PillArtBox" Visibility="Collapsed">
                        <Grid.Clip>
                            <EllipseGeometry Center="10,10" RadiusX="10" RadiusY="10"/>
                        </Grid.Clip>
                        <Border Background="#333333"/>
                        <Image x:Name="PillArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <ui:TreeShape x:Name="PillTreeLeft" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:TreeShape.LayoutTransform>
                            <ScaleTransform ScaleX="0.2" ScaleY="0.2"/>
                        </ui:TreeShape.LayoutTransform>
                    </ui:TreeShape>
                </Grid>

                <!-- Middle: song name for a moment, or tree + time when music also plays -->
                <Grid Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PillText" Foreground="White" FontSize="12" FontFamily="Segoe UI"
                               MaxWidth="260" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                    <StackPanel x:Name="PillFocusMid" Orientation="Horizontal" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:TreeShape x:Name="PillTreeMid">
                            <ui:TreeShape.LayoutTransform>
                                <ScaleTransform ScaleX="0.17" ScaleY="0.17"/>
                            </ui:TreeShape.LayoutTransform>
                        </ui:TreeShape>
                        <TextBlock x:Name="PillFocusMidText" Foreground="#34C759" FontSize="12" FontWeight="SemiBold"
                                   FontFamily="Segoe UI" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Right: sound bars, or the time left -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel x:Name="PillBars" Orientation="Horizontal" Height="14" Visibility="Collapsed">
                        <Rectangle x:Name="Bar1" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1.25,0" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar2" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1.25,0" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar3" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1.25,0" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar4" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1.25,0" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar5" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1.25,0" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar6" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1.25,0" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar7" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1.25,0" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                    <TextBlock x:Name="PillFocusText" Foreground="#34C759" FontSize="12" FontWeight="SemiBold"
                               FontFamily="Segoe UI" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ══════════ VOLUME: shown briefly when the volume changes ══════════ -->
        <Border x:Name="VolumeView"
                Visibility="Collapsed"
                Background="#000000"
                BorderThickness="1,0,1,1"
                BorderBrush="#3A3A3C"
                CornerRadius="0,0,15,15"
                Height="30"
                Width="260"
                Padding="12,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VolGlyph" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="White" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" Height="4" Margin="10,0" VerticalAlignment="Center">
                    <Border Background="#40FFFFFF" CornerRadius="2"/>
                    <Border Background="White" CornerRadius="2" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="VolFillScale" ScaleX="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <TextBlock x:Name="VolText" Grid.Column="2" Foreground="#CCFFFFFF" FontSize="11"
                           FontFamily="Segoe UI" MinWidth="24" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══════════ EXPANDED: tabs ══════════ -->
        <Border x:Name="Expanded"
                Visibility="Collapsed"
                Background="#000000"
                BorderThickness="1,0,1,1"
                BorderBrush="#3A3A3C"
                CornerRadius="0,0,24,24"
                Width="560"
                Padding="12,8,12,12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                RenderTransformOrigin="0.5,0"
                MouseEnter="Expanded_MouseEnter"
                MouseLeave="Expanded_MouseLeave">
            <Border.RenderTransform>
                <ScaleTransform x:Name="ExpandedScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="ExpandedGlow" Color="#5A5A5E" BlurRadius="22" ShadowDepth="0" Opacity="0.35"/>
            </Border.Effect>

            <StackPanel>
                <!-- Tab bar + time + battery -->
                <Grid Margin="0,0,2,10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabMusic" Style="{StaticResource TabButton}" GroupName="notchTabs" Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Nhạc" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabFocus" Style="{StaticResource TabButton}" GroupName="notchTabs" Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <ui:TreeShape VerticalAlignment="Center">
                                    <ui:TreeShape.LayoutTransform>
                                        <ScaleTransform ScaleX="0.15" ScaleY="0.15"/>
                                    </ui:TreeShape.LayoutTransform>
                                </ui:TreeShape>
                                <TextBlock Text="Trồng cây" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabNotifications" Style="{StaticResource TabButton}" GroupName="notchTabs" Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Thông báo" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText" Foreground="#DDFFFFFF" FontSize="12.5" FontWeight="SemiBold"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" Margin="12,0,0,0">
                            <TextBlock x:Name="BatteryGlyph" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BatteryText" Foreground="#CCFFFFFF" FontSize="12" FontFamily="Segoe UI"
                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid MinHeight="118">

                    <!-- ── Music ── -->
                    <Grid x:Name="MusicTab">
                        <Border x:Name="MusicTint" CornerRadius="16"/>
                        <StackPanel x:Name="MusicContent" Margin="10,10,10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="64" Height="64">
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,64,64" RadiusX="12" RadiusY="12"/>
                                    </Grid.Clip>
                                    <Border Background="#333333">
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Image x:Name="FullArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <!-- Long titles scroll right → left -->
                                    <Canvas x:Name="TitleClip" Height="21" ClipToBounds="True">
                                        <TextBlock x:Name="SongTitle" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                                   FontFamily="Segoe UI">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform x:Name="TitleShift"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Canvas>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="SongArtist" Foreground="#AAFFFFFF" FontSize="12.5"
                                                       FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="MusicAppName" Foreground="#66FFFFFF" FontSize="11"
                                                       FontFamily="Segoe UI"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                            <Button Style="{StaticResource PlayerButton}" Click="Prev_Click" ToolTip="Bài trước">
                                                <TextBlock Text="&#xE892;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                                            </Button>
                                            <Button Style="{StaticResource PlayerButton}" Click="PlayPause_Click" Margin="4,0"
                                                    Width="42" Height="38" ToolTip="Phát / Tạm dừng">
                                                <TextBlock x:Name="PlayPauseGlyph" Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="22"/>
                                            </Button>
                                            <Button Style="{StaticResource PlayerButton}" Click="Next_Click" ToolTip="Bài tiếp">
                                                <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                                            </Button>
                                        </StackPanel>

                                        <Grid x:Name="VolumeRow" Grid.Column="2" Width="132" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="26"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="AppVolumeGlyph" Text="&#xE767;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="13" Foreground="#AAFFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Slider Grid.Column="1" x:Name="VolumeSlider" Style="{StaticResource IslandSlider}"
                                                    Minimum="0" Maximum="100" Value="100" ValueChanged="VolumeSlider_ValueChanged"/>
                                            <TextBlock Grid.Column="2" x:Name="AppVolumeText" Text="100" Foreground="#99FFFFFF"
                                                       FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="SeekRow" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PositionText" Text="0:00" Foreground="#99FFFFFF" FontSize="11"
                                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="SeekSlider" Style="{StaticResource IslandSlider}"
                                        Minimum="0" Maximum="1" Margin="4,0"
                                        PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                                        ValueChanged="SeekSlider_ValueChanged"/>
                                <TextBlock Grid.Column="2" x:Name="DurationText" Text="0:00" Foreground="#99FFFFFF"
                                           FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock x:Name="NoMusicText" Text="Chưa có nhạc đang phát" Foreground="#80FFFFFF"
                                   FontSize="13" FontFamily="Segoe UI" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>

                    <!-- ── Tree planting ── -->
                    <Grid x:Name="FocusTab" Visibility="Collapsed" Margin="4,2,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Width="88" Height="88" CornerRadius="44" Background="#14241A" VerticalAlignment="Center">
                            <ui:TreeShape x:Name="BigTree" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:TreeShape.LayoutTransform>
                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                                </ui:TreeShape.LayoutTransform>
                            </ui:TreeShape>
                        </Border>

                        <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <!-- Not running: pick a tree and a duration -->
                            <StackPanel x:Name="FocusIdle">
                                <StackPanel x:Name="SpeciesPanel" Orientation="Horizontal"/>
                                <TextBlock x:Name="SpeciesHint" Foreground="#80FFFFFF" FontSize="11" FontFamily="Segoe UI"
                                           Margin="2,5,0,7"/>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel x:Name="PresetPanel" Orientation="Horizontal"/>
                                    <Button Content="Trồng cây" Style="{StaticResource ActionButton}" Click="Plant_Click"
                                            Margin="6,0,0,6" VerticalAlignment="Top"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Running: countdown -->
                            <StackPanel x:Name="FocusRunning" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="FocusRemaining" Foreground="White" FontSize="30"
                                               FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="FocusSub" Foreground="#99FFFFFF" FontSize="12" FontFamily="Segoe UI"
                                               Margin="12,0,0,5" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <Grid Height="4" Margin="0,8,0,10">
                                    <Border Background="#33FFFFFF" CornerRadius="2"/>
                                    <Border Background="#34C759" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="FocusFillScale" ScaleX="0"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <Button x:Name="GiveUpBtn" Content="Bỏ cuộc" Style="{StaticResource ActionButton}"
                                        Background="#3A1C1C" Foreground="#FF6B6B" Click="GiveUp_Click"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>

                        <!-- Today's forest -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="2,8,0,0">
                            <TextBlock x:Name="ForestStats" Foreground="#99FFFFFF" FontSize="11.5" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                            <StackPanel x:Name="ForestRow" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- ── Recent notifications ── -->
                    <Grid x:Name="NotificationsTab" Visibility="Collapsed">
                        <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Hidden" Focusable="False">
                            <StackPanel x:Name="RecentList"/>
                        </ScrollViewer>
                        <TextBlock x:Name="NoNotificationsText" Text="Chưa có thông báo nào" Foreground="#80FFFFFF"
                                   FontSize="13" FontFamily="Segoe UI" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
