<Window x:Class="DynamicIslandNotifier.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DynamicIslandNotifier.UI"
        Title="DynamicIslandNotch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Left="0" Top="0">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Round, borderless button (⏮ ⏯ ⏭) -->
        <Style x:Key="PlayerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded pill button: "Trồng cây", "Bỏ cuộc" -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#34C759"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Duration chips: 10p 25p 45p ... -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="#2A2A2A" CornerRadius="11" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#34C759"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider parts: filled part, remaining part, round knob -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#FFFFFFFF" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderRest" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#40FFFFFF" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderKnob" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="knob" Width="12" Height="12" Fill="White"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="knob" Property="Width" Value="14"/>
                                <Setter TargetName="knob" Property="Height" Value="14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IslandSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRest}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderKnob}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <!-- ══════════ COLLAPSED: the notch ══════════ -->
        <Border x:Name="Pill"
                Background="#000000"
                CornerRadius="0,0,14,14"
                Height="26"
                MinWidth="170"
                Padding="10,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Cursor="Hand"
                MouseEnter="Pill_MouseEnter"
                MouseLeave="Pill_MouseLeave"
                MouseLeftButtonUp="Pill_MouseLeftButtonUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: album art + sound bars -->
                <StackPanel x:Name="PillMusic" Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid Width="18" Height="18">
                        <Grid.Clip>
                            <EllipseGeometry Center="9,9" RadiusX="9" RadiusY="9"/>
                        </Grid.Clip>
                        <Border Background="#333333"/>
                        <Image x:Name="PillArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="7,0,0,0" Height="12" VerticalAlignment="Center">
                        <Rectangle x:Name="Bar1" Width="2.5" Height="12" RadiusX="1.2" RadiusY="1.2" Fill="White" Margin="1,0" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar2" Width="2.5" Height="12" RadiusX="1.2" RadiusY="1.2" Fill="White" Margin="1,0" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar3" Width="2.5" Height="12" RadiusX="1.2" RadiusY="1.2" Fill="White" Margin="1,0" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar4" Width="2.5" Height="12" RadiusX="1.2" RadiusY="1.2" Fill="White" Margin="1,0" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                </StackPanel>

                <!-- Middle: song name for a few seconds when a new track starts -->
                <TextBlock x:Name="PillText" Grid.Column="1" Foreground="White" FontSize="12"
                           FontFamily="Segoe UI" Margin="10,0" MaxWidth="260"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"/>

                <!-- Right: growing tree + time left -->
                <StackPanel x:Name="PillFocus" Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <ui:TreeShape x:Name="PillTree">
                        <ui:TreeShape.LayoutTransform>
                            <ScaleTransform ScaleX="0.19" ScaleY="0.19"/>
                        </ui:TreeShape.LayoutTransform>
                    </ui:TreeShape>
                    <TextBlock x:Name="PillFocusText" Foreground="#34C759" FontSize="12" FontWeight="SemiBold"
                               FontFamily="Segoe UI" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ VOLUME: shown briefly when the volume changes ══════════ -->
        <Border x:Name="VolumeView"
                Visibility="Collapsed"
                Background="#000000"
                CornerRadius="0,0,14,14"
                Height="30"
                Width="250"
                Padding="12,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VolGlyph" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="White" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" Height="4" Margin="10,0" VerticalAlignment="Center">
                    <Border Background="#40FFFFFF" CornerRadius="2"/>
                    <Border Background="White" CornerRadius="2" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="VolFillScale" ScaleX="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <TextBlock x:Name="VolText" Grid.Column="2" Foreground="#CCFFFFFF" FontSize="11"
                           FontFamily="Segoe UI" MinWidth="24" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══════════ EXPANDED: everything ══════════ -->
        <Border x:Name="Expanded"
                Visibility="Collapsed"
                Background="#000000"
                CornerRadius="0,0,26,26"
                Width="420"
                Padding="14,10,14,14"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                RenderTransformOrigin="0.5,0"
                MouseEnter="Expanded_MouseEnter"
                MouseLeave="Expanded_MouseLeave">
            <Border.RenderTransform>
                <ScaleTransform x:Name="ExpandedScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <StackPanel>
                <!-- Time + battery -->
                <Grid Margin="4,0,4,10">
                    <TextBlock x:Name="ClockText" Foreground="White" FontSize="13" FontWeight="SemiBold"
                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="BatteryGlyph" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BatteryText" Foreground="#CCFFFFFF" FontSize="12" FontFamily="Segoe UI"
                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ── Music (tinted from the album art) ── -->
                <Border x:Name="MusicSection" CornerRadius="18" Padding="14,12" Margin="0,0,0,10"
                        BorderThickness="1" Background="#1C1C1E" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="56" Height="56">
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,56,56" RadiusX="12" RadiusY="12"/>
                                </Grid.Clip>
                                <Border Background="#333333">
                                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Image x:Name="FullArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SongTitle" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                           FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SongArtist" Foreground="#AAFFFFFF" FontSize="12.5"
                                           FontFamily="Segoe UI" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="MusicAppName" Foreground="#80FFFFFF" FontSize="11"
                                       FontFamily="Segoe UI" VerticalAlignment="Top"/>
                        </Grid>

                        <Grid x:Name="SeekRow" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="PositionText" Text="0:00" Foreground="#99FFFFFF"
                                       FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="SeekSlider" Style="{StaticResource IslandSlider}"
                                    Minimum="0" Maximum="1" Margin="4,0"
                                    PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                                    ValueChanged="SeekSlider_ValueChanged"/>
                            <TextBlock Grid.Column="2" x:Name="DurationText" Text="0:00" Foreground="#99FFFFFF"
                                       FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Style="{StaticResource PlayerButton}" Click="Prev_Click" ToolTip="Bài trước">
                                <TextBlock Text="&#xE892;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                            </Button>
                            <Button Style="{StaticResource PlayerButton}" Click="PlayPause_Click" Margin="14,0"
                                    Width="50" Height="42" ToolTip="Phát / Tạm dừng">
                                <TextBlock x:Name="PlayPauseGlyph" Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="24"/>
                            </Button>
                            <Button Style="{StaticResource PlayerButton}" Click="Next_Click" ToolTip="Bài tiếp">
                                <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                            </Button>
                        </StackPanel>

                        <Grid x:Name="VolumeRow" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="AppVolumeGlyph" Text="&#xE767;"
                                       FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#AAFFFFFF"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider Grid.Column="1" x:Name="VolumeSlider" Style="{StaticResource IslandSlider}"
                                    Minimum="0" Maximum="100" Value="100"
                                    ValueChanged="VolumeSlider_ValueChanged"/>
                            <TextBlock Grid.Column="2" x:Name="AppVolumeText" Text="100" Foreground="#99FFFFFF"
                                       FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Focus: plant a tree ── -->
                <Border x:Name="FocusSection" CornerRadius="18" Padding="14,12" Margin="0,0,0,10" Background="#121A15">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="84" Height="84" CornerRadius="42" Background="#1F2E24" VerticalAlignment="Top">
                                <ui:TreeShape x:Name="BigTree" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:TreeShape.LayoutTransform>
                                        <ScaleTransform ScaleX="0.78" ScaleY="0.78"/>
                                    </ui:TreeShape.LayoutTransform>
                                </ui:TreeShape>
                            </Border>

                            <Grid Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <!-- Not running: choose a duration -->
                                <StackPanel x:Name="FocusIdle">
                                    <TextBlock Text="Trồng cây tập trung" Foreground="White" FontSize="15"
                                               FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="Chọn thời gian, cây sẽ lớn dần khi bạn tập trung" Foreground="#99FFFFFF"
                                               FontSize="11.5" FontFamily="Segoe UI" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                    <WrapPanel x:Name="PresetPanel"/>
                                    <Button Content="Trồng cây" Style="{StaticResource ActionButton}" Click="Plant_Click"
                                            HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Running: countdown -->
                                <StackPanel x:Name="FocusRunning" Visibility="Collapsed">
                                    <TextBlock x:Name="FocusRemaining" Foreground="White" FontSize="30"
                                               FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="FocusSub" Foreground="#99FFFFFF" FontSize="12" FontFamily="Segoe UI"/>
                                    <Grid Height="4" Margin="0,8,0,10">
                                        <Border Background="#33FFFFFF" CornerRadius="2"/>
                                        <Border Background="#34C759" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="FocusFillScale" ScaleX="0"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    <Button x:Name="GiveUpBtn" Content="Bỏ cuộc" Style="{StaticResource ActionButton}"
                                            Background="#3A1C1C" Foreground="#FF6B6B" Click="GiveUp_Click"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Today's forest -->
                        <Grid Margin="0,10,0,0">
                            <TextBlock x:Name="ForestStats" Foreground="#99FFFFFF" FontSize="11.5" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                            <StackPanel x:Name="ForestRow" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Recent notifications ── -->
                <Border x:Name="RecentSection" CornerRadius="18" Padding="10,10" Background="#161616"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Thông báo gần đây" Foreground="#99FFFFFF" FontSize="11.5"
                                   FontFamily="Segoe UI" Margin="6,0,0,6"/>
                        <StackPanel x:Name="RecentList"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
