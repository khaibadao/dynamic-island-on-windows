<Window x:Class="DynamicIslandNotifier.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DynamicIslandNotifier.UI"
        Title="DynamicIslandNotch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="1000" Height="380"
        Left="0" Top="0">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Album colour (replaced from code) -->
        <SolidColorBrush x:Key="AccentBrush" Color="White"/>

        <!-- Quick buttons in the tab bar: mic, Do Not Disturb, screenshot, lock -->
        <Style x:Key="QuickButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Big ‹ › arrows at the panel's sides -->
        <Style x:Key="SideArrow" TargetType="Button">
            <Setter Property="Foreground" Value="#BBFFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin sideways scroll bar (clipboard images) -->
        <Style x:Key="ThinHScroll" TargetType="ScrollBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="MinHeight" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#26FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Border x:Name="t" Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                            Background="{DynamicResource AccentBrush}"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="t" Property="Height" Value="7"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="t" Property="Height" Value="7"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tabs: Nhạc / Trồng cây / Thông báo -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="12" Padding="9,5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="#DDFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2C2C2E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round, borderless button (⏮ ⏯ ⏭) -->
        <Style x:Key="PlayerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded pill button: "Trồng cây", "Bỏ cuộc" -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#34C759"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Duration chips: 10p 25p 45p ... -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="#2A2A2A" CornerRadius="11" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#34C759"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider parts: filled part, remaining part, round knob -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderRest" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#40FFFFFF" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderKnob" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="knob" Width="12" Height="12" Fill="White"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="knob" Property="Width" Value="14"/>
                                <Setter TargetName="knob" Property="Height" Value="14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IslandSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRest}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderKnob}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Side and bottom margin leaves room for the glow -->
    <Grid Margin="24,0,24,24">

        <!-- Mây peeks out from behind the right end of the notch (drawn first, so the notch covers part of her) -->
        <ui:MayPeek x:Name="CatRest" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False">
            <ui:MayPeek.RenderTransform>
                <TranslateTransform x:Name="CatRestShift" X="101"/>
            </ui:MayPeek.RenderTransform>
        </ui:MayPeek>
        <!-- ══════════ RESTING: clicks pass through to the browser tabs underneath ══════════ -->
        <!-- The whole window ignores the mouse while resting; the pointer is watched instead:
             nearby → the notch fades, resting on it ~0.4 s → the panel opens. -->
        <Grid x:Name="RestArea" HorizontalAlignment="Center" VerticalAlignment="Top">

            <!-- Nothing playing: a thin strip  \_______/  -->
            <Border x:Name="StripHost" Height="9" Width="200" Background="#01000000"
                    HorizontalAlignment="Center" VerticalAlignment="Top">
                <Path x:Name="Strip" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="#000000"
                      Stroke="#3A3A3C" StrokeThickness="1.5" StrokeLineJoin="Round"
                      Data="M 0,0 L 200,0 L 190,4.6 Q 187,6 183,6 L 17,6 Q 13,6 10,4.6 Z">
                    <Path.Effect>
                        <DropShadowEffect x:Name="StripGlow" Color="#5A5A5E" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                    </Path.Effect>
                </Path>
            </Border>

            <!-- Playing / a tree growing: a slim pill, art · title · sound bars, progress along the bottom -->
            <Border x:Name="Pill"
                    Visibility="Collapsed"
                    Background="#000000"
                    BorderThickness="1,0,1,1"
                    BorderBrush="#3A3A3C"
                    CornerRadius="0,0,11,11"
                    Height="22"
                    MinWidth="140"
                    MaxWidth="300"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect x:Name="PillGlow" Color="#5A5A5E" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid Margin="4,0,9,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: album art, or the growing tree -->
                        <Grid x:Name="PillLeft" Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                            <Grid x:Name="PillArtBox" Visibility="Collapsed">
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,16,16" RadiusX="4" RadiusY="4"/>
                                </Grid.Clip>
                                <Border Background="#333333"/>
                                <Image x:Name="PillArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <ui:TreeShape x:Name="PillTreeLeft" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:TreeShape.LayoutTransform>
                                    <ScaleTransform ScaleX="0.16" ScaleY="0.16"/>
                                </ui:TreeShape.LayoutTransform>
                            </ui:TreeShape>
                        </Grid>

                        <!-- Middle: the song's name -->
                        <TextBlock x:Name="PillText" Grid.Column="1" Foreground="#EEFFFFFF" FontSize="11.5" FontFamily="Segoe UI"
                                   Margin="7,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                        <!-- Right: time left on the tree, sound bars -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PillFocusText" Foreground="#34C759" FontSize="11" FontWeight="SemiBold"
                                       FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                            <StackPanel x:Name="PillBars" Orientation="Horizontal" Height="10" VerticalAlignment="Center" Visibility="Collapsed">
                            <Rectangle x:Name="Bar1" Width="2.5" Height="10" RadiusX="1.25" RadiusY="1.25" Fill="White" Margin="0.9,0" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Bar2" Width="2.5" Height="10" RadiusX="1.25" RadiusY="1.25" Fill="White" Margin="0.9,0" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Bar3" Width="2.5" Height="10" RadiusX="1.25" RadiusY="1.25" Fill="White" Margin="0.9,0" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Bar4" Width="2.5" Height="10" RadiusX="1.25" RadiusY="1.25" Fill="White" Margin="0.9,0" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Bar5" Width="2.5" Height="10" RadiusX="1.25" RadiusY="1.25" Fill="White" Margin="0.9,0" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Bar6" Width="2.5" Height="10" RadiusX="1.25" RadiusY="1.25" Fill="White" Margin="0.9,0" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Bar7" Width="2.5" Height="10" RadiusX="1.25" RadiusY="1.25" Fill="White" Margin="0.9,0" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                            </Rectangle>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Thin progress line along the bottom edge -->
                    <Border VerticalAlignment="Bottom" Height="1.5" Margin="10,0,10,0" Background="#26FFFFFF"/>
                    <Border x:Name="PillProgress" VerticalAlignment="Bottom" Height="1.5" Margin="10,0,10,0"
                            Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PillProgressScale" ScaleX="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════ VOLUME: shown briefly when the volume changes ══════════ -->
        <Border x:Name="VolumeView"
                Visibility="Collapsed"
                Background="#000000"
                BorderThickness="1,0,1,1"
                BorderBrush="#3A3A3C"
                CornerRadius="0,0,15,15"
                Height="30"
                Width="260"
                Padding="12,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VolGlyph" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="White" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" Height="4" Margin="10,0" VerticalAlignment="Center">
                    <Border Background="#40FFFFFF" CornerRadius="2"/>
                    <Border Background="White" CornerRadius="2" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="VolFillScale" ScaleX="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <TextBlock x:Name="VolText" Grid.Column="2" Foreground="#CCFFFFFF" FontSize="11"
                           FontFamily="Segoe UI" MinWidth="24" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══════════ EXPANDED ══════════ -->
        <!-- status row on top · icon sidebar on the left · the tab's content -->
        <Border x:Name="Expanded"
                Visibility="Collapsed"
                Background="#000000"
                BorderThickness="1,0,1,1"
                BorderBrush="#3A3A3C"
                CornerRadius="0,0,24,24"
                Width="620"
                Padding="6,6,10,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                RenderTransformOrigin="0.5,0"
                MouseEnter="Expanded_MouseEnter"
                MouseLeave="Expanded_MouseLeave">
            <Border.RenderTransform>
                <ScaleTransform x:Name="ExpandedScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="ExpandedGlow" Color="#5A5A5E" BlurRadius="22" ShadowDepth="0" Opacity="0.35"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Status row: time · battery · headphones | quick buttons -->
                <Grid Grid.Column="1" Margin="4,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" Margin="12,0,0,0">
                            <TextBlock x:Name="BatteryGlyph" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BatteryText" Foreground="#CCFFFFFF" FontSize="12" FontFamily="Segoe UI"
                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="HeadsetPanel" Orientation="Horizontal" Margin="12,0,0,0" Visibility="Collapsed">
                            <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HeadsetText" Foreground="#CCFFFFFF" FontSize="12" FontFamily="Segoe UI"
                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="MicBtn" Style="{StaticResource QuickButton}" Content="&#xE720;" Click="Mic_Click"/>
                        <Button x:Name="DndBtn" Style="{StaticResource QuickButton}" Content="&#xE708;" Click="Dnd_Click"/>
                        <Button Style="{StaticResource QuickButton}" Content="&#xE722;" Click="Screenshot_Click" ToolTip="Chụp màn hình (Win + Shift + S)"/>
                        <Button Style="{StaticResource QuickButton}" Content="&#xE72E;" Click="Lock_Click" ToolTip="Khoá máy"/>
                    </StackPanel>
                </Grid>

                <!-- Sidebar: one icon per tab (built in code) -->
                <StackPanel x:Name="SideBar" Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="0,2,6,0"/>

                <!-- The tab's content; its height follows the tab -->
                <Border x:Name="ContentCard" Grid.Row="1" Grid.Column="1" Background="#1C1C1F" CornerRadius="16"
                        ClipToBounds="True" MinHeight="128">
                <Grid x:Name="TabContent">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="TabShift"/>
                    </Grid.RenderTransform>

                    <!-- ── Music ── -->
                    <Grid x:Name="MusicTab">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="LyricsColumn" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="MusicTint" CornerRadius="16" Grid.ColumnSpan="2"/>
                        <StackPanel x:Name="MusicContent" Margin="10,10,10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="64" Height="64">
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,64,64" RadiusX="12" RadiusY="12"/>
                                    </Grid.Clip>
                                    <Border Background="#333333">
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Image x:Name="FullArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <!-- Long titles scroll right → left -->
                                    <Canvas x:Name="TitleClip" Height="21" ClipToBounds="True">
                                        <TextBlock x:Name="SongTitle" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                                   FontFamily="Segoe UI">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform x:Name="TitleShift"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Canvas>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="SongArtist" Foreground="#AAFFFFFF" FontSize="12.5"
                                                       FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="MusicAppName" Foreground="#88FFFFFF" FontSize="11"
                                                       FontFamily="Segoe UI"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                            <Button Style="{StaticResource PlayerButton}" Click="Prev_Click" ToolTip="Bài trước">
                                                <TextBlock Text="&#xE892;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                                            </Button>
                                            <Button Style="{StaticResource PlayerButton}" Click="PlayPause_Click" Margin="4,0"
                                                    Width="42" Height="38" ToolTip="Phát / Tạm dừng">
                                                <TextBlock x:Name="PlayPauseGlyph" Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="22"/>
                                            </Button>
                                            <Button Style="{StaticResource PlayerButton}" Click="Next_Click" ToolTip="Bài tiếp">
                                                <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                                            </Button>
                                            <Button x:Name="LyricsBtn" Style="{StaticResource PlayerButton}" Click="Lyrics_Click"
                                                    Margin="2,0,0,0" ToolTip="Lời bài hát">
                                                <TextBlock x:Name="LyricsGlyph" Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                                            </Button>
                                        </StackPanel>

                                        <Grid x:Name="VolumeRow" Grid.Column="2" Width="112" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="26"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="AppVolumeGlyph" Text="&#xE767;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="13" Foreground="#AAFFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Slider Grid.Column="1" x:Name="VolumeSlider" Style="{StaticResource IslandSlider}"
                                                    Minimum="0" Maximum="100" Value="100" ValueChanged="VolumeSlider_ValueChanged"/>
                                            <TextBlock Grid.Column="2" x:Name="AppVolumeText" Text="100" Foreground="#99FFFFFF"
                                                       FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="SeekRow" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PositionText" Text="0:00" Foreground="#99FFFFFF" FontSize="11"
                                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <ui:WavySeekBar Grid.Column="1" x:Name="SeekBar" Margin="4,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="DurationText" Text="0:00" Foreground="#99FFFFFF"
                                           FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="NoMusicText" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border Width="56" Height="56" CornerRadius="16" Background="#1E1E21" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                           Foreground="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Chưa có nhạc đang phát" Foreground="#CCFFFFFF" FontSize="13.5" FontWeight="SemiBold"
                                       FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                            <TextBlock Text="Mở Spotify, YouTube hay app nhạc bất kỳ, bài hát sẽ hiện ở đây"
                                       Foreground="#88FFFFFF" FontSize="11.5" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Synced lyrics (opened with the lyrics button), like Spotify -->
                        <Grid x:Name="LyricsPane" Grid.Column="1" Margin="4,8,8,8" Visibility="Collapsed">
                            <ScrollViewer x:Name="LyricsScroll" Height="160" VerticalScrollBarVisibility="Hidden"
                                          Focusable="False" PanningMode="VerticalOnly">
                                <ScrollViewer.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="Black" Offset="0.18"/>
                                        <GradientStop Color="Black" Offset="0.82"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </ScrollViewer.OpacityMask>
                                <StackPanel x:Name="LyricsList" Margin="6,60,6,60"/>
                            </ScrollViewer>
                            <TextBlock x:Name="LyricsStatus" Foreground="#99FFFFFF" FontSize="13" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- ── Tree planting ── -->
                    <Grid x:Name="FocusTab" Visibility="Collapsed" Margin="4,2,4,0">
                      <Grid x:Name="FocusMain">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Width="88" Height="88" CornerRadius="44" Background="#14241A" VerticalAlignment="Center">
                            <ui:TreeShape x:Name="BigTree" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:TreeShape.LayoutTransform>
                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                                </ui:TreeShape.LayoutTransform>
                            </ui:TreeShape>
                        </Border>

                        <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <!-- Not running: pick a tree and a duration -->
                            <StackPanel x:Name="FocusIdle">
                                <StackPanel x:Name="SpeciesPanel" Orientation="Horizontal"/>
                                <TextBlock x:Name="SpeciesHint" Foreground="#99FFFFFF" FontSize="11" FontFamily="Segoe UI"
                                           Margin="2,5,0,7"/>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel x:Name="PresetPanel" Orientation="Horizontal"/>
                                    <Button Content="Trồng cây" Style="{StaticResource ActionButton}" Click="Plant_Click"
                                            Margin="6,0,0,6" VerticalAlignment="Top"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Running: countdown -->
                            <StackPanel x:Name="FocusRunning" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="FocusRemaining" Foreground="White" FontSize="30"
                                               FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="FocusSub" Foreground="#99FFFFFF" FontSize="12" FontFamily="Segoe UI"
                                               Margin="12,0,0,5" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <Grid Height="4" Margin="0,8,0,10">
                                    <Border Background="#33FFFFFF" CornerRadius="2"/>
                                    <Border Background="#34C759" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="FocusFillScale" ScaleX="0"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <Button x:Name="GiveUpBtn" Content="Bỏ cuộc" Style="{StaticResource ActionButton}"
                                        Background="#3A1C1C" Foreground="#FF6B6B" Click="GiveUp_Click"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>

                        <!-- Today's forest -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="2,8,0,0">
                            <TextBlock x:Name="ForestStats" Foreground="#99FFFFFF" FontSize="11.5" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                            <StackPanel x:Name="ForestRow" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center"/>
                        </Grid>
                      </Grid>

                      <!-- Weekly stats: minutes per day for the last 7 days + streak -->
                      <Grid x:Name="FocusStats" Visibility="Collapsed">
                          <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="*"/>
                          </Grid.RowDefinitions>
                          <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                              <TextBlock Text="7 ngày qua" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                         FontFamily="Segoe UI" VerticalAlignment="Center"/>
                              <TextBlock x:Name="WeekSummary" Foreground="#99FFFFFF" FontSize="12" FontFamily="Segoe UI"
                                         Margin="12,0,0,0" VerticalAlignment="Center"/>
                          </StackPanel>
                          <Grid x:Name="WeekChart" Grid.Row="1" Height="104"/>
                      </Grid>

                      <!-- Switch between the two views -->
                      <TextBlock x:Name="FocusViewToggle" Text="Thống kê tuần ›" Foreground="#34C759" FontSize="12"
                                 FontFamily="Segoe UI" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,2,2,0" MouseLeftButtonUp="FocusViewToggle_Click"/>
                    </Grid>

                    <!-- ── Recent notifications ── -->
                    <Grid x:Name="NotificationsTab" Visibility="Collapsed" Margin="10,8,10,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                          Focusable="False" Margin="0,0,96,0" PreviewMouseWheel="SidewaysWheel">
                                <StackPanel x:Name="NotifFilters" Orientation="Horizontal"/>
                            </ScrollViewer>
                            <Button x:Name="ClearAllBtn" Content="Xoá tất cả" Style="{StaticResource ActionButton}"
                                    Background="#2C2C2E" Foreground="#DDFFFFFF" Padding="10,3" FontSize="11.5"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearAll_Click"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" MaxHeight="190" VerticalScrollBarVisibility="Hidden" Focusable="False">
                            <StackPanel x:Name="RecentList"/>
                        </ScrollViewer>
                        <StackPanel x:Name="NoNotificationsText" Grid.Row="1" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Visibility="Collapsed" Margin="0,16">
                            <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                       Foreground="#40FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Chưa có thông báo nào" Foreground="#99FFFFFF" FontSize="13"
                                       FontFamily="Segoe UI" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- ── Văn bản: copied texts ── -->
                    <Grid x:Name="TextsTab" Visibility="Collapsed" Margin="10,8,10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#2A2A2E" CornerRadius="10" Height="30" Padding="10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="ClipSearchPlaceholder" Grid.Column="1" Text="Tìm trong lịch sử copy…"
                                               Foreground="#88FFFFFF" FontSize="12.5" FontFamily="Segoe UI"
                                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBox x:Name="ClipSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                             Foreground="White" CaretBrush="White" FontSize="12.5" FontFamily="Segoe UI"
                                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                                             PreviewMouseLeftButtonDown="ClipSearch_PreviewMouseLeftButtonDown"
                                             KeyDown="ClipSearch_KeyDown" TextChanged="ClipSearch_TextChanged"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ClipToast" Foreground="#34C759" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0"/>
                                <Button x:Name="ClipClearBtn" Content="Xoá mục chưa ghim" Style="{StaticResource ActionButton}"
                                        Background="#2E2E33" Foreground="#EEFFFFFF" Padding="10,3" FontSize="11.5"
                                        Click="ClipClear_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="ClipTextScroll" MaxHeight="190" VerticalScrollBarVisibility="Hidden" Focusable="False">
                                <StackPanel x:Name="ClipTextList"/>
                            </ScrollViewer>
                            <TextBlock x:Name="ClipEmpty" Foreground="#99FFFFFF" FontSize="12.5" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,18"/>
                        </Grid>
                    </Grid>

                    <!-- ── Hình ảnh: copied images in a row you scroll sideways ── -->
                    <Grid x:Name="ImagesTab" Visibility="Collapsed" Margin="10,8,10,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,0,8">
                            <TextBlock x:Name="ImgCount" Foreground="#99FFFFFF" FontSize="12" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="ImgToast" Foreground="#34C759" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0"/>
                                <Button Style="{StaticResource QuickButton}" Width="26" Height="24" FontSize="10.5"
                                        Content="&#xE76B;" Click="ClipImagesLeft_Click" ToolTip="Ảnh mới hơn"/>
                                <Button Style="{StaticResource QuickButton}" Width="26" Height="24" FontSize="10.5" Margin="2,0,8,0"
                                        Content="&#xE76C;" Click="ClipImagesRight_Click" ToolTip="Ảnh cũ hơn"/>
                                <Button x:Name="ImgClearBtn" Content="Xoá ảnh chưa ghim" Style="{StaticResource ActionButton}"
                                        Background="#2E2E33" Foreground="#EEFFFFFF" Padding="10,3" FontSize="11.5"
                                        Click="ImgClear_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="ClipImageScroll" HorizontalScrollBarVisibility="Visible"
                                          VerticalScrollBarVisibility="Disabled" Focusable="False"
                                          PreviewMouseWheel="SidewaysWheel">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinHScroll}"/>
                                </ScrollViewer.Resources>
                                <StackPanel x:Name="ClipImageList" Orientation="Horizontal" Margin="0,0,0,6"/>
                            </ScrollViewer>
                            <TextBlock x:Name="ImgEmpty" Foreground="#99FFFFFF" FontSize="12.5" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,24"
                                       Text="Chưa có ảnh nào. Chụp màn hình (Win + Shift + S) hoặc copy một ảnh, nó sẽ hiện ở đây."/>
                        </Grid>
                    </Grid>
                </Grid>
                </Border>

                <!-- Mây sits on the card's bottom-right corner -->
                <ui:MayCat x:Name="CatPanel" Grid.Row="1" Grid.Column="1" Size="26" HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" Margin="0,0,14,-10" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
