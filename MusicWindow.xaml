<Window x:Class="DynamicIslandNotifier.MusicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DynamicIslandMusic"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Round, borderless button (⏮ ⏯ ⏭) -->
        <Style x:Key="PlayerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider parts: filled part, remaining part, round knob -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#FFFFFFFF" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderRest" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#40FFFFFF" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderKnob" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="knob" Width="12" Height="12" Fill="White"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="knob" Property="Width" Value="14"/>
                                <Setter TargetName="knob" Property="Height" Value="14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IslandSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRest}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderKnob}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="4">

        <!-- ══════════ MINI: small pill with album art + sound bars ══════════ -->
        <Border x:Name="MiniView"
                Background="#000000"
                CornerRadius="20"
                Height="40"
                Padding="6,0,14,0"
                Cursor="SizeAll"
                ToolTip="Kéo để di chuyển · Di chuột vào để mở"
                MouseEnter="Mini_MouseEnter"
                MouseLeave="Mini_MouseLeave">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="28" Height="28">
                    <Grid.Clip>
                        <EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14"/>
                    </Grid.Clip>
                    <Border Background="#333333">
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Image x:Name="MiniArt" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>

                <!-- Sound bars: bounce while playing, rest while paused -->
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" Height="18" VerticalAlignment="Center">
                    <Rectangle x:Name="Bar1" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1.5,0" RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Bar2" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1.5,0" RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Bar3" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1.5,0" RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Bar4" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1.5,0" RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                    </Rectangle>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════ FULL: the player ══════════ -->
        <Border x:Name="FullView"
                Visibility="Collapsed"
                Background="#000000"
                CornerRadius="26"
                Width="360"
                Padding="16,16,16,12"
                RenderTransformOrigin="0,0"
                MouseEnter="Full_MouseEnter"
                MouseLeave="Full_MouseLeave">
            <Border.RenderTransform>
                <ScaleTransform x:Name="FullScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <StackPanel>
                <!-- Art + title + artist -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="56" Height="56">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,56,56" RadiusX="12" RadiusY="12"/>
                        </Grid.Clip>
                        <Border Background="#333333">
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="22"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Image x:Name="FullArt" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                   FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ArtistText" Foreground="#AAFFFFFF" FontSize="12.5"
                                   FontFamily="Segoe UI" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" x:Name="AppNameText" Foreground="#5FFFFFFF" FontSize="11"
                               FontFamily="Segoe UI" VerticalAlignment="Top"/>
                </Grid>

                <!-- Seek bar -->
                <Grid x:Name="SeekRow" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="PositionText" Text="0:00" Foreground="#88FFFFFF"
                               FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="SeekSlider" Style="{StaticResource IslandSlider}"
                            Minimum="0" Maximum="1" Margin="4,0"
                            PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                            ValueChanged="SeekSlider_ValueChanged"/>
                    <TextBlock Grid.Column="2" x:Name="DurationText" Text="0:00" Foreground="#88FFFFFF"
                               FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>

                <!-- ⏮ ⏯ ⏭ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button Style="{StaticResource PlayerButton}" Click="Prev_Click" ToolTip="Bài trước">
                        <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons" FontSize="18"/>
                    </Button>
                    <Button Style="{StaticResource PlayerButton}" Click="PlayPause_Click" Margin="14,0" Width="52" Height="44" ToolTip="Phát / Tạm dừng">
                        <TextBlock x:Name="PlayPauseGlyph" Text="&#xE769;" FontFamily="Segoe Fluent Icons" FontSize="24"/>
                    </Button>
                    <Button Style="{StaticResource PlayerButton}" Click="Next_Click" ToolTip="Bài tiếp">
                        <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons" FontSize="18"/>
                    </Button>
                </StackPanel>

                <!-- Volume (this app only) -->
                <Grid x:Name="VolumeRow" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="VolumeGlyph" Text="&#xE767;" FontFamily="Segoe Fluent Icons"
                               FontSize="14" Foreground="#AAFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider Grid.Column="1" x:Name="VolumeSlider" Style="{StaticResource IslandSlider}"
                            Minimum="0" Maximum="100" Value="100"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                    <TextBlock Grid.Column="2" x:Name="VolumeText" Text="100" Foreground="#88FFFFFF"
                               FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
